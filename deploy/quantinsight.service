[Unit]
Description=QuantInsight Pro (Streamlit)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quantinsight
Environment=PATH=/opt/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/miniconda3/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1 --server.headless=true
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
