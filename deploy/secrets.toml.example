# QuantInsight Pro · secrets.toml 模板
# 生成命令: python scripts/sync_llm_secrets.py "D:\自定义大模型配置.txt"
# ECS 路径: /opt/quantinsight/.streamlit/secrets.toml  (chmod 600)

# 主 LLM — Token Plan (Qwen)
QWEN_API_KEY = "your-token-plan-api-key"
QWEN_MODEL = "qwen3.6-plus"
QWEN_BASE_URL = "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions"

# 备选 1 — SenseNova
SENSENOVA_API_KEY = "your-sensenova-api-key"
SENSENOVA_MODEL = "sensenova-6.7-flash-lite"
SENSENOVA_BASE_URL = "https://token.sensenova.cn/v1/chat/completions"

# 备选 2 — StepFun
STEPFUN_API_KEY = "your-stepfun-api-key"
STEPFUN_MODEL = "step-3.7-flash"
STEPFUN_BASE_URL = "https://api.stepfun.com/v1/chat/completions"

# RAG 向量嵌入（可选，需标准 DashScope Key）
# DASHSCOPE_API_KEY = "your-dashscope-api-key"
# DASHSCOPE_EMBED_MODEL = "text-embedding-v2"

# QVeris 金融数据 API (实时行情 / 历史 K 线兜底)
# 获取: https://qveris.cn/account?page=api-keys
QVERIS_API_KEY = "sk-cn-your-qveris-api-key"
