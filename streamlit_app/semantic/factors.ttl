    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 20 个交易日；{w} 日变动率（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(20)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "动量(20)" .

qi:momentum_5 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 5 个交易日；{w} 日变动率（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(5)" ;
    qi:inCategory qi:cat_rolling ;
