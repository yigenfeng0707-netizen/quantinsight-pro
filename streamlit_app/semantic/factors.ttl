@prefix qi: <http://quantinsight.pro/ontology/> .

qi:atr_14 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "真实波幅均值（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close,
        qi:m_high,
        qi:m_low ;
    qi:formula "TR = max(high−low, |high−prev_close|, |low−prev_close|)，ATR = TR 的 14 日移动平均" ;
    qi:inCategory qi:cat_technical ;
    qi:name "ATR(14)" .

qi:atr_14_pct a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "波动幅度（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close,
        qi:m_high,
        qi:m_low ;
    qi:formula "ATR(14) / close" ;
    qi:inCategory qi:cat_technical ;
    qi:name "ATR 百分比" .

qi:bb_lower a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "布林带（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 20) − 2 × STD(close, 20)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "布林带下轨" .

qi:bb_middle a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "布林带（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 20)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "布林带中轨" .

qi:bb_upper a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "布林带（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 20) + 2 × STD(close, 20)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "布林带上轨" .

qi:f_growth a qi:Factor ;
    qi:bindingApi "features/factor_scorer.py::MultiFactorScorer" ;
    qi:caliber "适度涨幅 + 量比活跃（factor_scorer.py:126-152）；四类等权 0.25 合成总分（factor_scorer.FACTOR_WEIGHTS）" ;
    qi:computedFrom qi:m_pct_change,
        qi:m_volume_ratio ;
    qi:formula "当日涨幅分段：0–5% 为 0.8+0.04x，>5% 为 0.6，<0 为 0.3+0.02x；量比 clip [0, 10]，1–3 为 0.8，>3 为 0.5，<1 为 0.3；两步滚动加权 0.5/0.5 与 0.7/0.3" ;
    qi:inCategory qi:cat_growth ;
    qi:name "成长因子" .

qi:f_momentum a qi:Factor ;
    qi:bindingApi "features/factor_scorer.py::MultiFactorScorer" ;
    qi:caliber "60 日涨幅适中为优（factor_scorer.py:184-199）；四类等权 0.25 合成总分（factor_scorer.FACTOR_WEIGHTS）" ;
    qi:computedFrom qi:m_pct_60d ;
    qi:formula "60 日涨跌幅 clip [−50, 100]，5–30% 为 0.8+(p−5)×0.008，0–5% 为 0.6，>30% 为 0.4，<0 为 0.2+p×0.01（直接覆盖基准分）" ;
    qi:inCategory qi:cat_momentum ;
    qi:name "动量因子" .

qi:f_quality a qi:Factor ;
    qi:bindingApi "features/factor_scorer.py::MultiFactorScorer" ;
    qi:caliber "换手率适中 + 市值中大型（factor_scorer.py:154-182）；四类等权 0.25 合成总分（factor_scorer.FACTOR_WEIGHTS）" ;
    qi:computedFrom qi:m_total_mv,
        qi:m_turnover ;
    qi:formula "换手率 clip [0, 30]，1–5% 为 0.9，5–10% 为 0.6，<1 为 0.3，>10 为 0.4；总市值（亿元）100–2000 为 0.9，50–100 为 0.7，>2000 为 0.6，其余 0.4；滚动加权 0.5/0.5 与 0.6/0.4" ;
    qi:inCategory qi:cat_quality ;
    qi:name "质量因子" .

qi:f_value a qi:Factor ;
    qi:bindingApi "features/factor_scorer.py::MultiFactorScorer" ;
    qi:caliber "PE/PB 越低得分越高（factor_scorer.py:112-124）；四类等权 0.25 合成总分（factor_scorer.FACTOR_WEIGHTS）" ;
    qi:computedFrom qi:m_pb,
        qi:m_pe_ttm ;
    qi:formula "PE 分位与 PB 分位加权：PE clip 至 [1, 200] 后取 1−(PE−1)/199；PB clip 至 [0.1, 20] 后取 1−(PB−0.1)/19.9；基准 0.5 与两者滚动加权（PE 步 0.5/0.5，PB 步 0.7/0.3）" ;
    qi:inCategory qi:cat_value ;
    qi:name "价值因子" .

qi:kurt_10 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 10 个交易日；超额峰度（−3），≥4 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "KURT(close, 10)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "峰度(10)" .

qi:kurt_120 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 120 个交易日；超额峰度（−3），≥4 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "KURT(close, 120)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "峰度(120)" .

qi:kurt_20 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 20 个交易日；超额峰度（−3），≥4 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "KURT(close, 20)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "峰度(20)" .

qi:kurt_5 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 5 个交易日；超额峰度（−3），≥4 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "KURT(close, 5)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "峰度(5)" .

qi:kurt_60 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 60 个交易日；超额峰度（−3），≥4 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "KURT(close, 60)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "峰度(60)" .

qi:macd_dea a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "MACD 信号线（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "DEA = EMA(DIF, 9)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "MACD DEA" .

qi:macd_dif a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "MACD 快线（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "DIF = EMA(close, 12) − EMA(close, 26)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "MACD DIF" .

qi:macd_hist a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "MACD 柱（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "HIST = 2 × (DIF − DEA)（柱状图放大 2 倍）" ;
    qi:inCategory qi:cat_technical ;
    qi:name "MACD HIST" .

qi:mean_10 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 10 个交易日；移动平均线（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 10)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "均值(10)" .

qi:mean_120 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 120 个交易日；移动平均线（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 120)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "均值(120)" .

qi:mean_20 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 20 个交易日；移动平均线（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 20)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "均值(20)" .

qi:mean_5 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 5 个交易日；移动平均线（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 5)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "均值(5)" .

qi:mean_60 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 60 个交易日；移动平均线（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MA(close, 60)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "均值(60)" .

qi:momentum_10 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 10 个交易日；{w} 日变动率（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(10)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "动量(10)" .

qi:momentum_120 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 120 个交易日；{w} 日变动率（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(120)" ;
