qi:momentum_60 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 60 个交易日；{w} 日变动率（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(60)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "动量(60)" .

qi:obv a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "能量潮（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close,
        qi:m_volume ;
    qi:formula "cumsum：close > prev → +volume；close < prev → −volume；相等 → 0" ;
    qi:inCategory qi:cat_technical ;
    qi:name "OBV 能量潮" .

qi:obv_ma20 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "能量潮均线（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close,
        qi:m_volume ;
    qi:formula "MA(OBV, 20)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "OBV 20 日均线" .

qi:rsi_14 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "相对强弱指数（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "同 RSI(6)，周期 14" ;
    qi:inCategory qi:cat_technical ;
    qi:name "RSI(14)" .

qi:rsi_28 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "相对强弱指数（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "同 RSI(6)，周期 28" ;
    qi:inCategory qi:cat_technical ;
    qi:name "RSI(28)" .

qi:rsi_6 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.technical_indicators" ;
    qi:caliber "相对强弱指数（qlib_integration.py:255-360）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "100×avg_gain/(avg_gain+avg_loss)，avg_gain/avg_loss 为涨跌幅的 EWM(alpha=1/period)" ;
    qi:inCategory qi:cat_technical ;
    qi:name "RSI(6)" .

qi:shap_Current_Ratio a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:formula "流动资产 / 流动负债" ;
    qi:inCategory qi:cat_shap ;
    qi:name "流动比率" .

qi:shap_Debt_Ratio a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越低越好（shap_explainer.py:75-93）" ;
    qi:formula "总负债 / 总资产" ;
    qi:inCategory qi:cat_shap ;
    qi:name "资产负债率" .

qi:shap_Float_Cap a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_circ_mv ;
    qi:formula "流通股本 × 最新股价" ;
    qi:inCategory qi:cat_shap ;
    qi:name "流通市值" .

qi:shap_Gross_Margin a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_gross_margin ;
    qi:formula "(营业收入 − 营业成本) / 营业收入" ;
    qi:inCategory qi:cat_shap ;
    qi:name "毛利率" .

qi:shap_MACD_Signal a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "MACD DIF 与 DEA 的交叉信号" ;
    qi:inCategory qi:cat_shap ;
    qi:name "MACD信号" .

qi:shap_Momentum_20D a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(20)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "20日动量" .

qi:shap_Momentum_60D a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "close.pct_change(60)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "60日动量" .

qi:shap_NetProfit_Growth a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_net_profit ;
    qi:formula "(本期净利润 − 上期) / 上期" ;
    qi:inCategory qi:cat_shap ;
    qi:name "净利润增速" .

qi:shap_PB a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越低越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_pb ;
    qi:formula "股价 / 每股净资产" ;
    qi:inCategory qi:cat_shap ;
    qi:name "市净率" .

qi:shap_PE_TTM a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越低越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_pe_ttm ;
    qi:formula "总市值 / 归母净利润(TTM)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "市盈率TTM" .

qi:shap_PS_TTM a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越低越好（shap_explainer.py:75-93）" ;
    qi:formula "总市值 / 营业收入(TTM)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "市销率TTM" .

qi:shap_ROE a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_net_profit_parent ;
    qi:formula "归母净利润 / 净资产" ;
    qi:inCategory qi:cat_shap ;
    qi:name "净资产收益率" .

qi:shap_RSI_14 a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：中性（shap_explainer.py:75-93）" ;
    qi:formula "100×avg_gain/(avg_gain+avg_loss)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "14日RSI" .

qi:shap_Revenue_Growth a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_revenue ;
    qi:formula "(本期营业收入 − 上期) / 上期" ;
    qi:inCategory qi:cat_shap ;
    qi:name "营收增速" .

qi:shap_Turnover_20D a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_turnover ;
    qi:formula "MA(turnover, 20)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "20日均换手率" .

qi:shap_Volatility_20D a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越低越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "STD(close, 20) / MA(close, 20)" ;
    qi:inCategory qi:cat_shap ;
    qi:name "20日波动率" .

qi:shap_Volume_Ratio a qi:Factor ;
    qi:bindingApi "features/shap_explainer.py::FACTOR_DEFINITIONS" ;
    qi:caliber "XGBoost 特征，方向：越高越好（shap_explainer.py:75-93）" ;
    qi:computedFrom qi:m_volume_ratio ;
    qi:formula "当日成交量 / 过去5日平均成交量" ;
    qi:inCategory qi:cat_shap ;
    qi:name "量比" .

qi:skew_10 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 10 个交易日；偏度，≥3 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "SKEW(close, 10)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "偏度(10)" .

qi:skew_120 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 120 个交易日；偏度，≥3 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "SKEW(close, 120)" ;
    qi:inCategory qi:cat_rolling ;
    qi:name "偏度(120)" .

qi:skew_20 a qi:Factor ;
    qi:bindingApi "features/qlib_integration.py::AlphaFactorMiner.rolling_stats" ;
    qi:caliber "窗口 20 个交易日；偏度，≥3 个数据点（qlib_integration.py:199-225）" ;
    qi:computedFrom qi:m_close ;
    qi:formula "SKEW(close, 20)" ;
